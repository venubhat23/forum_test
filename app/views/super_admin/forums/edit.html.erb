<% content_for :title, "Edit #{@forum.name}" %>

<div class="page-header">
  <h1 class="page-title h4">Edit <%= @forum.name %></h1>
  <p class="page-subtitle mb-0"><%= forum_root_url(forum_slug: @forum.slug) %> &middot; slug can't be changed here.</p>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-lg-7">
    <div class="card">
      <div class="card-body p-4">
        <%= form_with model: @forum, url: super_admin_forum_path(@forum), method: :patch, local: true do |f| %>
          <div class="mb-4">
            <%= f.label :name, "Forum Name", class: "form-label" %>
            <%= f.text_field :name, class: "form-control form-control-lg", required: true %>
          </div>

          <hr class="my-4">
          <h2 class="h6 mb-3">Billing Details</h2>
          <p class="text-muted small mb-3">Used on invoices raised to this forum &mdash; shown as "Not provided" if left blank.</p>

          <div class="mb-3">
            <%= f.label :gst_number, "GST Number", class: "form-label" %>
            <%= f.text_field :gst_number, class: "form-control", placeholder: "e.g. 27AAAAA0000A1Z5" %>
          </div>

          <div class="mb-3">
            <%= f.label :office, "Office", class: "form-label" %>
            <%= f.text_field :office, class: "form-control", placeholder: "e.g. Registered Office / HQ" %>
          </div>

          <div class="mb-4">
            <%= f.label :address, class: "form-label" %>
            <%= f.text_area :address, class: "form-control", rows: 3 %>
          </div>

          <hr class="my-4">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h6 text-uppercase text-muted mb-0">Website Theme</h2>
            <%= link_to "Preview all", super_admin_website_templates_path, target: "_blank", rel: "noopener", class: "small" %>
          </div>
          <div class="row g-3 mb-4">
            <% ForumSetting::TEMPLATES.each do |key, info| %>
              <div class="col-12 col-sm-6">
                <label class="card h-100 plan-option-card p-0">
                  <div class="ratio ratio-21x9" style="background: linear-gradient(135deg, <%= info[:swatches][0] %> 0%, <%= info[:swatches][1] %> 100%); border-radius: 0.85rem 0.85rem 0 0;"></div>
                  <div class="p-3">
                    <div class="form-check mb-1">
                      <%= radio_button_tag "forum_setting[website_template]", key, key == @setting.website_template, class: "form-check-input" %>
                      <%= label_tag "forum_setting_website_template_#{key}", info[:name], class: "form-check-label fw-semibold" %>
                    </div>
                    <p class="text-muted small mb-0"><%= info[:tagline] %></p>
                  </div>
                </label>
              </div>
            <% end %>
          </div>

          <div class="d-flex flex-wrap gap-2">
            <%= f.submit "Save Changes", class: "btn btn-primary btn-lg" %>
            <%= link_to "Cancel", super_admin_forum_path(@forum), class: "btn btn-outline-secondary btn-lg" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
