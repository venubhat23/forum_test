<% content_for :title, "Billing Settings" %>

<div class="page-header">
  <h1 class="page-title h4">Billing Settings</h1>
  <p class="page-subtitle mb-0">Platform-wide invoicing defaults &mdash; also used to render invoices raised to forums.</p>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <%= form_with model: @setting, url: super_admin_billing_path, method: :patch, local: true do |f| %>

      <div class="card mb-4">
        <div class="card-header fw-semibold"><i class="bi bi-sliders me-1"></i> General</div>
        <div class="card-body p-4">
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
              <%= f.label :site_name, class: "form-label" %>
              <%= f.text_field :site_name, class: "form-control", required: true %>
            </div>
            <div class="col-12 col-md-6">
              <%= f.label :support_email, class: "form-label" %>
              <%= f.email_field :support_email, class: "form-control" %>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-12 col-md-4">
              <%= f.label :currency, class: "form-label" %>
              <%= f.text_field :currency, class: "form-control", required: true %>
            </div>
            <div class="col-12 col-md-4">
              <%= f.label :invoice_prefix, class: "form-label" %>
              <%= f.text_field :invoice_prefix, class: "form-control", required: true %>
            </div>
            <div class="col-12 col-md-4">
              <%= f.label :tax_percent, class: "form-label" %>
              <%= f.number_field :tax_percent, class: "form-control", step: "0.01", min: 0 %>
            </div>
          </div>

          <div>
            <%= f.label :default_plan_id, "Default plan for new forums", class: "form-label" %>
            <%= f.collection_select :default_plan_id, @plans, :id, :name, { include_blank: "None" }, class: "form-select" %>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header fw-semibold"><i class="bi bi-file-earmark-text me-1"></i> Terms &amp; Conditions</div>
        <div class="card-body p-4">
          <p class="text-muted small mb-3">Printed on every forum-level invoice, below the line items.</p>
          <%= f.text_area :terms_and_conditions, class: "form-control", rows: 5,
                placeholder: "e.g. 1. Payment due within 7 days of invoice date.\n2. Late payments may attract a penalty.\n3. Fees once paid are non-refundable." %>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header fw-semibold"><i class="bi bi-bank me-1"></i> Banking Details</div>
        <div class="card-body p-4">
          <p class="text-muted small mb-3">Shown on forum-level invoices so payments can be made by bank transfer.</p>
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
              <%= f.label :bank_name, class: "form-label" %>
              <%= f.text_field :bank_name, class: "form-control", placeholder: "e.g. HDFC Bank" %>
            </div>
            <div class="col-12 col-md-6">
              <%= f.label :bank_account_holder, "Account Holder Name", class: "form-label" %>
              <%= f.text_field :bank_account_holder, class: "form-control", placeholder: "e.g. Krama Consultancy Pvt Ltd" %>
            </div>
          </div>
          <div class="row g-3">
            <div class="col-12 col-md-4">
              <%= f.label :bank_account_number, "Account Number", class: "form-label" %>
              <%= f.text_field :bank_account_number, class: "form-control" %>
            </div>
            <div class="col-12 col-md-4">
              <%= f.label :bank_ifsc, "IFSC Code", class: "form-label" %>
              <%= f.text_field :bank_ifsc, class: "form-control text-uppercase" %>
            </div>
            <div class="col-12 col-md-4">
              <%= f.label :bank_branch, "Branch", class: "form-label" %>
              <%= f.text_field :bank_branch, class: "form-control" %>
            </div>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header fw-semibold"><i class="bi bi-qr-code me-1"></i> UPI &amp; QR Code</div>
        <div class="card-body p-4">
          <p class="text-muted small mb-3">Enter a UPI ID and it's automatically rendered as a scannable QR code on every forum-level invoice.</p>
          <div class="row g-3 align-items-start">
            <div class="col-12 col-md-7">
              <%= f.label :upi_id, "UPI ID", class: "form-label" %>
              <%= f.text_field :upi_id, class: "form-control", placeholder: "e.g. krama@okhdfcbank" %>
              <div class="form-text">Saved changes are reflected in the preview after you save.</div>
            </div>
            <% if @setting.upi_id.present? %>
              <div class="col-12 col-md-5 text-center">
                <div class="d-inline-block p-2 bg-white border rounded-3">
                  <%= upi_qr_code_svg(@setting.upi_id, payee_name: @setting.bank_account_holder.presence || @setting.site_name, size: 3) %>
                </div>
                <div class="text-muted small mt-1">Live preview</div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%= f.submit "Save Settings", class: "btn btn-primary btn-lg" %>
    <% end %>
  </div>
</div>
