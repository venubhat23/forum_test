<% content_for :title, "Complete Your Profile" %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <div class="text-center mb-4">
        <h1 class="h4 fw-bold mb-1">Complete Your Profile</h1>
        <p class="text-muted mb-0"><%= @guest.chapter.name %> &middot; <%= @guest.forum.name %></p>
      </div>

      <% if flash[:notice] %>
        <div class="alert alert-success"><%= flash[:notice] %></div>
      <% end %>

      <% if @invited_meetings.present? %>
        <div class="card mb-4">
          <div class="card-header fw-semibold"><i class="bi bi-calendar-event me-1"></i> Meeting Invitation<%= "s" if @invited_meetings.size > 1 %></div>
          <div class="card-body">
            <% @invited_meetings.each do |meeting| %>
              <div class="d-flex flex-wrap justify-content-between align-items-start gap-3<%= " pb-3 mb-3 border-bottom" unless meeting == @invited_meetings.last %>">
                <div>
                  <div class="fw-semibold"><%= meeting.topic.presence || "#{meeting.meeting_type.titleize} Meeting" %></div>
                  <div class="text-muted small">
                    <i class="bi bi-calendar3 me-1"></i><%= meeting.scheduled_at.strftime("%d %b %Y") %>
                    &middot; <i class="bi bi-clock me-1"></i><%= meeting.scheduled_at.strftime("%I:%M %p") %>
                    <% if meeting.venue.present? %>&middot; <i class="bi bi-geo-alt me-1"></i><%= meeting.venue %><% end %>
                  </div>
                </div>
                <div class="text-end">
                  <% if meeting.fee_amount.present? %>
                    <span class="badge bg-warning-subtle text-warning-emphasis fs-6"><%= number_to_currency(meeting.fee_amount) %> fee</span>
                  <% else %>
                    <span class="badge bg-success-subtle text-success">No fee</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="card">
        <div class="card-body p-4">
          <p class="text-muted mb-4">Fill in your details below. You can come back and update this anytime using the same link — it will be ready for our team to review when you're converted to a member.</p>

          <%= form_with model: @guest, url: guest_profile_form_path(token: @guest.profile_token),
                method: :patch, scope: :guest, local: true, html: { multipart: true },
                data: { controller: "submit-loading", action: "submit->submit-loading#start" } do |f| %>
            <h2 class="h6 text-uppercase text-muted mb-3">Basic Profile</h2>
            <div class="mb-3">
              <%= f.label :full_name, "Owner Name", class: "form-label" %>
              <%= f.text_field :full_name, class: "form-control", required: true %>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-12 col-sm-6">
                <%= f.label :email, class: "form-label" %>
                <%= f.email_field :email, class: "form-control", required: true %>
              </div>
              <div class="col-12 col-sm-6">
                <%= f.label :phone, "Phone Number", class: "form-label" %>
                <%= f.telephone_field :phone, class: "form-control", required: true %>
              </div>
            </div>
            <div class="row g-3 mb-4">
              <div class="col-12 col-sm-6">
                <%= f.label :date_of_birth, class: "form-label" %>
                <%= f.date_field :date_of_birth, class: "form-control" %>
              </div>
              <div class="col-12 col-sm-6" data-controller="image-preview">
                <%= f.label :photo, "Photo", class: "form-label" %>
                <%= f.file_field :photo, class: "form-control", accept: "image/*",
                      data: { action: "change->image-preview#preview", "image-preview-target": "input" } %>
                <% if @guest.photo.attached? %><div class="form-text">A photo is already on file — choose a new one only to replace it.</div><% end %>
                <div class="mt-2 <%= "d-none" unless @guest.photo.attached? %>" data-image-preview-target="wrapper">
                  <% if @guest.photo.attached? %>
                    <%= image_tag @guest.photo, data: { "image-preview-target": "image" }, style: "max-height: 120px; border-radius: 8px; object-fit: cover;", alt: "Photo preview" %>
                  <% else %>
                    <img data-image-preview-target="image" style="max-height: 120px; border-radius: 8px; object-fit: cover;" alt="Photo preview">
                  <% end %>
                </div>
              </div>
            </div>

            <h2 class="h6 text-uppercase text-muted mb-3">Business Details</h2>
            <div class="mb-3">
              <%= f.label :business_name, "Business Name", class: "form-label" %>
              <%= f.text_field :business_name, class: "form-control", required: true %>
            </div>
            <% categories_map = business_categories_map(@guest.forum) %>
            <div class="row g-3 mb-3" data-controller="business-category"
                 data-business-category-categories-value="<%= categories_map.to_json %>"
                 data-business-category-selected-value="<%= @guest.speciality %>">
              <div class="col-12 col-sm-6">
                <%= f.label :business_category, "Business Category", class: "form-label" %>
                <%= f.select :business_category, categories_map.keys, {}, class: "form-select",
                      data: { business_category_target: "category", action: "change->business-category#categoryChanged" } %>
              </div>
              <div class="col-12 col-sm-6">
                <%= f.label :speciality, class: "form-label" %>
                <%= f.select :speciality, [], {}, class: "form-select", data: { business_category_target: "speciality" } %>
              </div>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-12 col-sm-6">
                <%= f.label :business_category_id, "Category (from list)", class: "form-label" %>
                <%= f.collection_select :business_category_id, @guest.forum.business_categories.order(:name), :id, :name, { include_blank: true }, class: "form-select" %>
              </div>
              <div class="col-12 col-sm-6">
                <%= f.label :website, class: "form-label" %>
                <%= f.text_field :website, class: "form-control", placeholder: "https://..." %>
              </div>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-12 col-sm-6">
                <%= f.label :capacity, "Business Capacity", class: "form-label" %>
                <%= f.text_field :capacity, class: "form-control", placeholder: "e.g. 500 units/month, team of 12" %>
              </div>
              <div class="col-12 col-sm-6">
                <%= f.label :service_area, "Service Coverage Area", class: "form-label" %>
                <%= f.text_field :service_area, class: "form-control", placeholder: "e.g. Only Bengaluru" %>
              </div>
            </div>
            <div class="mb-4" data-controller="image-preview">
              <%= f.label :company_logo, "Company Logo", class: "form-label" %>
              <%= f.file_field :company_logo, class: "form-control", accept: "image/*",
                    data: { action: "change->image-preview#preview", "image-preview-target": "input" } %>
              <% if @guest.company_logo.attached? %><div class="form-text">A logo is already on file — choose a new one only to replace it.</div><% end %>
              <div class="mt-2 <%= "d-none" unless @guest.company_logo.attached? %>" data-image-preview-target="wrapper">
                <% if @guest.company_logo.attached? %>
                  <%= image_tag @guest.company_logo, data: { "image-preview-target": "image" }, style: "max-height: 120px; border-radius: 8px; object-fit: cover;", alt: "Company logo preview" %>
                <% else %>
                  <img data-image-preview-target="image" style="max-height: 120px; border-radius: 8px; object-fit: cover;" alt="Company logo preview">
                <% end %>
              </div>
            </div>

            <h2 class="h6 text-uppercase text-muted mb-3">Address</h2>
            <div class="mb-3">
              <%= f.label :address, class: "form-label" %>
              <%= f.text_area :address, class: "form-control", rows: 2 %>
            </div>
            <div class="mb-4">
              <%= f.label :city, "Location (City)", class: "form-label" %>
              <%= f.text_field :city, class: "form-control" %>
            </div>

            <h2 class="h6 text-uppercase text-muted mb-3">Statutory Details</h2>
            <div class="row g-3 mb-3">
              <div class="col-12 col-sm-4">
                <%= f.label :gst_number, "GST Number", class: "form-label" %>
                <%= f.text_field :gst_number, class: "form-control" %>
              </div>
              <div class="col-12 col-sm-4">
                <%= f.label :pan_number, "PAN Number", class: "form-label" %>
                <%= f.text_field :pan_number, class: "form-control" %>
              </div>
              <div class="col-12 col-sm-4">
                <%= f.label :aadhaar_number, "Aadhaar Number", class: "form-label" %>
                <%= f.text_field :aadhaar_number, class: "form-control" %>
              </div>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-12 col-sm-4">
                <%= f.label :gst_document, "Upload GST Certificate", class: "form-label" %>
                <%= f.file_field :gst_document, class: "form-control" %>
                <%= render "uploaded_document", document: @guest.gst_document %>
              </div>
              <div class="col-12 col-sm-4">
                <%= f.label :pan_document, "Upload PAN Card", class: "form-label" %>
                <%= f.file_field :pan_document, class: "form-control" %>
                <%= render "uploaded_document", document: @guest.pan_document %>
              </div>
              <div class="col-12 col-sm-4">
                <%= f.label :aadhaar_document, "Upload Aadhaar Card", class: "form-label" %>
                <%= f.file_field :aadhaar_document, class: "form-control" %>
                <%= render "uploaded_document", document: @guest.aadhaar_document %>
              </div>
            </div>
            <div class="mb-4">
              <%= f.label :kyc_documents, "Other KYC Documents (optional, multiple allowed)", class: "form-label" %>
              <%= f.file_field :kyc_documents, multiple: true, class: "form-control" %>
              <% if @guest.kyc_documents.attached? %>
                <div class="form-text mb-2"><%= pluralize(@guest.kyc_documents.count, "document") %> already on file — new uploads are added, not replaced.</div>
                <% @guest.kyc_documents.each do |doc| %>
                  <%= render "uploaded_document", document: doc %>
                <% end %>
              <% end %>
            </div>

            <h2 class="h6 text-uppercase text-muted mb-3">Meeting Fee</h2>
            <div class="mb-4" data-controller="fee-toggle image-preview">
              <% fee_meetings = @invited_meetings.select { |m| m.fee_amount.present? } %>
              <% fee_label = if fee_meetings.size == 1
                   "I have paid the #{number_to_currency(fee_meetings.first.fee_amount)} meeting fee"
                 elsif fee_meetings.size > 1
                   "I have paid the meeting fee(s) (#{fee_meetings.map { |m| number_to_currency(m.fee_amount) }.join(', ')})"
                 else
                   "I have paid the meeting fee"
                 end %>

              <% fee_meetings.select { |m| m.payment_upi_id.present? || m.payment_qr.attached? }.each do |meeting| %>
                <div class="d-flex flex-wrap align-items-center gap-3 p-3 mb-3 border rounded bg-light-subtle">
                  <% if meeting.payment_qr.attached? %>
                    <%= image_tag meeting.payment_qr, style: "height: 100px; width: 100px; object-fit: contain; border-radius: 6px; background: #fff; padding: 4px; border: 1px solid #e2e8f0;", alt: "Payment QR code" %>
                  <% end %>
                  <div>
                    <div class="fw-semibold small text-uppercase text-muted mb-1">How to pay &middot; <%= number_to_currency(meeting.fee_amount) %></div>
                    <% if meeting.payment_upi_id.present? %>
                      <div><i class="bi bi-phone me-1"></i> UPI / PhonePe: <strong><%= meeting.payment_upi_id %></strong></div>
                    <% end %>
                    <% if meeting.payment_bank_details.present? %>
                      <div class="text-muted small mt-1"><%= simple_format(meeting.payment_bank_details) %></div>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <div class="form-check mb-2">
                <%= f.check_box :meeting_fee_paid, class: "form-check-input",
                      data: { action: "fee-toggle#toggle", "fee-toggle-target": "checkbox" } %>
                <%= f.label :meeting_fee_paid, fee_label, class: "form-check-label" %>
              </div>
              <div data-fee-toggle-target="amountWrap" class="<%= "d-none" unless @guest.meeting_fee_paid? %>">
                <%= f.label :meeting_fee_screenshot, "Upload Payment Screenshot", class: "form-label" %>
                <%= f.file_field :meeting_fee_screenshot, accept: "image/*", class: "form-control",
                      data: { action: "change->image-preview#preview", "fee-toggle-target": "amountField", "image-preview-target": "input" } %>
                <% if @guest.meeting_fee_screenshot.attached? %><div class="form-text">A screenshot is already on file — choose a new one only to replace it.</div><% end %>
                <div class="mt-2 <%= "d-none" unless @guest.meeting_fee_screenshot.attached? %>" data-image-preview-target="wrapper">
                  <% if @guest.meeting_fee_screenshot.attached? %>
                    <%= image_tag @guest.meeting_fee_screenshot, data: { "image-preview-target": "image" }, style: "max-height: 120px; border-radius: 8px; object-fit: cover;", alt: "Payment screenshot preview" %>
                  <% else %>
                    <img data-image-preview-target="image" style="max-height: 120px; border-radius: 8px; object-fit: cover;" alt="Payment screenshot preview">
                  <% end %>
                </div>
              </div>
            </div>

            <h2 class="h6 text-uppercase text-muted mb-3">Social Media</h2>
            <div class="mb-4">
              <%= f.label :social_media_handle, "Social Media Handle(s)", class: "form-label" %>
              <%= f.text_field :social_media_handle, class: "form-control", placeholder: "e.g. Instagram @yourbusiness, Facebook /yourbusiness" %>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100" data-submit-loading-target="button" data-loading-text="Saving...">
              <span data-submit-loading-target="spinner" class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
              <span data-submit-loading-target="label"><i class="bi bi-check-circle me-1"></i> Save My Details</span>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
