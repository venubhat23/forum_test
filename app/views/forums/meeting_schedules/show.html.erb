<% content_for :title, @schedule.title.presence || "#{@schedule.day_name} Meeting Schedule" %>

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
  <div>
    <h1 class="page-title h4"><%= @schedule.title.presence || "#{@schedule.day_name} Meeting Schedule" %></h1>
    <p class="page-subtitle mb-0">
      <%= @chapter.name %> &middot; <%= @current_forum.name %>
      <% if @schedule.topic.present? %> &middot; <%= @schedule.topic %><% end %>
    </p>
  </div>
  <% if can? :destroy, @schedule %>
    <%= button_to "Cancel Schedule", forum_chapter_meeting_schedule_path(forum_slug: @current_forum.slug, chapter_id: @chapter.id, id: @schedule.id), method: :delete, class: "btn btn-outline-danger",
          data: { turbo_confirm: "Cancel this schedule? Future meetings will be removed; past meetings stay on record." } %>
  <% end %>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="stats-card">
      <div class="icon-bg gradient-blue"><i class="bi bi-calendar-week"></i></div>
      <div>
        <div class="stats-value h6 mb-0">Every <%= @schedule.day_name %></div>
        <div class="stats-label">Recurs</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stats-card">
      <div class="icon-bg gradient-purple"><i class="bi bi-clock"></i></div>
      <div>
        <div class="stats-value h6 mb-0"><%= @schedule.start_time.strftime("%I:%M %p") %>–<%= @schedule.end_time.strftime("%I:%M %p") %></div>
        <div class="stats-label">Time</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stats-card">
      <div class="icon-bg gradient-green"><i class="bi bi-calendar3"></i></div>
      <div>
        <div class="stats-value h6 mb-0"><%= @schedule.start_date.strftime("%d %b") %> – <%= @schedule.end_date.strftime("%d %b %Y") %></div>
        <div class="stats-label">Date Range</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stats-card">
      <div class="icon-bg gradient-teal"><i class="bi bi-list-check"></i></div>
      <div>
        <div class="stats-value"><%= @occurrences.size %></div>
        <div class="stats-label">Occurrences</div>
      </div>
    </div>
  </div>
  <% if @schedule.fee_amount.present? %>
    <div class="col-6 col-lg-3">
      <div class="stats-card">
        <div class="icon-bg gradient-emerald"><i class="bi bi-cash-coin"></i></div>
        <div>
          <div class="stats-value h6 mb-0"><%= number_to_currency(@schedule.fee_amount) %></div>
          <div class="stats-label">Entry Fee (per meeting)</div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @schedule.venue.present? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Venue</div>
    <div class="card-body"><%= @schedule.venue %></div>
  </div>
<% end %>

<%
  # Prefer the schedule's own payment fields; fall back to whichever
  # generated meeting has them set. Meetings already support payment_upi_id/
  # payment_qr today, so this shows real data immediately even while the
  # schedule-level columns are still pending migration (see MeetingSchedule).
  schedule_has_payment_info = @schedule.payment_upi_id.present? || @schedule.payment_qr.attached? || @schedule.payment_bank_details.present?
  payment_source = schedule_has_payment_info ? @schedule : @occurrences.find { |m| m.payment_upi_id.present? || m.payment_qr.attached? }
  display_fee = @schedule.fee_amount || @occurrences.find { |m| m.fee_amount.present? }&.fee_amount
%>
<% if display_fee.present? && payment_source.present? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Fee &amp; Payment Info</div>
    <div class="card-body">
      <p class="mb-3">Fee: <strong><%= number_to_currency(display_fee) %></strong> per meeting</p>
      <% unless schedule_has_payment_info %>
        <p class="text-muted small mb-3"><i class="bi bi-info-circle me-1"></i> Pulled from <%= payment_source.scheduled_at.strftime("%d %b %Y") %>'s meeting — set it here on the schedule to apply it to every occurrence.</p>
      <% end %>
      <div class="d-flex flex-wrap gap-4">
        <% if payment_source.payment_qr.attached? %>
          <div>
            <div class="text-muted small mb-1">Scan to pay</div>
            <%= image_tag payment_source.payment_qr, style: "height: 160px;" %>
          </div>
        <% end %>
        <div>
          <% if payment_source.payment_upi_id.present? %>
            <div class="mb-2"><span class="text-muted small">UPI / PhonePe:</span> <strong><%= payment_source.payment_upi_id %></strong></div>
          <% end %>
          <% if payment_source.payment_bank_details.present? %>
            <div><span class="text-muted small">Bank details:</span><br><%= simple_format(payment_source.payment_bank_details) %></div>
          <% end %>
        </div>
      </div>
      <% if schedule_has_payment_info %>
        <p class="text-muted small mt-3 mb-0">Applied to every generated meeting in this schedule.</p>
      <% end %>
    </div>
  </div>
<% end %>

<% if @schedule.agenda.present? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Agenda</div>
    <div class="card-body"><%= simple_format(@schedule.agenda) %></div>
  </div>
<% end %>

<% if @schedule.notes.present? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Other Requirements</div>
    <div class="card-body"><%= simple_format(@schedule.notes) %></div>
  </div>
<% end %>

<% if @schedule.speaker.present? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Guest Speaker</div>
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span><%= @schedule.speaker %><%= " · #{@schedule.speaker_phone}" if @schedule.speaker_phone.present? %></span>
      <% if can?(:update, @schedule) && (wa_link = whatsapp_schedule_speaker_invite_link(@schedule, @current_forum)) %>
        <%= link_to wa_link, class: "icon-btn icon-btn-whatsapp", title: "Send invite via WhatsApp", target: "_blank", rel: "noopener" do %>
          <i class="bi bi-whatsapp"></i>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-header fw-semibold">Invited Attendees</div>
  <div class="list-group list-group-flush">
    <% @schedule.attendees.order(:full_name).each do |attendee| %>
      <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><%= attendee.display_name %> <span class="text-muted small"><%= attendee.email %></span></span>
        <div class="d-flex align-items-center gap-2">
          <% if can?(:update, @schedule) && (wa_link = whatsapp_schedule_invite_link(attendee, @schedule, @current_forum)) %>
            <%= link_to wa_link, class: "icon-btn icon-btn-whatsapp", title: "Send invite via WhatsApp", target: "_blank", rel: "noopener" do %>
              <i class="bi bi-whatsapp"></i>
            <% end %>
          <% end %>
          <% if can? :update, @schedule %>
            <%= button_to remove_attendee_forum_chapter_meeting_schedule_path(forum_slug: @current_forum.slug, chapter_id: @chapter.id, id: @schedule.id, user_id: attendee.id),
                  method: :delete, class: "icon-btn icon-btn-danger", title: "Remove attendee",
                  data: { turbo_confirm: "Remove #{attendee.display_name} from this schedule?" } do %>
              <i class="bi bi-x-lg"></i>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if @schedule.attendees.empty? %>
      <div class="list-group-item text-muted text-center py-3">No attendees invited.</div>
    <% end %>
  </div>
  <% if can?(:update, @schedule) && @addable_candidates.present? %>
    <div class="card-body border-top">
      <%= form_with url: add_attendees_forum_chapter_meeting_schedule_path(forum_slug: @current_forum.slug, chapter_id: @chapter.id, id: @schedule.id),
            method: :post, local: true, data: { controller: "submit-loading", action: "submit->submit-loading#start" } do %>
        <div class="mb-2">
          <%= label_tag "attendee_ids", "Add Attendees", class: "form-label" %>
          <% candidates_by_chapter = @addable_candidates.group_by(&:chapter) %>
          <%= select_tag "attendee_ids[]",
                grouped_options_for_select(candidates_by_chapter.map { |chapter, people| [ chapter&.name || "No Chapter", people.map { |p| [ p.display_name, p.id ] } ] }),
                multiple: true, class: "form-select" %>
        </div>
        <button type="submit" class="btn btn-outline-primary btn-sm" data-submit-loading-target="button" data-loading-text="Adding...">
          <span data-submit-loading-target="spinner" class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
          <span data-submit-loading-target="label"><i class="bi bi-person-plus me-1"></i> Add Selected</span>
        </button>
      <% end %>
    </div>
  <% end %>
</div>

<%= render "status_panel", schedule: @schedule, occurrences: @occurrences %>
