<% content_for :title, "Forum Settings" %>

<div class="page-header">
  <h1 class="page-title h4">Forum Settings</h1>
  <p class="page-subtitle mb-0"><%= @current_forum.name %></p>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-lg-7">
    <div class="card">
      <div class="card-body p-4">
        <%= form_with model: @setting, url: forum_settings_path(forum_slug: @current_forum.slug), method: :patch, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :logo, class: "form-label" %>
            <%= f.file_field :logo, class: "form-control", accept: "image/*" %>
            <% if @setting.logo.attached? %>
              <div class="text-muted small mt-1">Current: <%= @setting.logo.filename %></div>
            <% end %>
          </div>
          <div class="mb-3">
            <%= f.label :theme_color, class: "form-label" %>
            <%= f.color_field :theme_color, class: "form-control form-control-color" %>
          </div>
          <div class="mb-3">
            <%= f.label :invoice_prefix, class: "form-label" %>
            <%= f.text_field :invoice_prefix, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= f.label :attendance_rules, class: "form-label" %>
            <%= f.text_area :attendance_rules, class: "form-control", rows: 2 %>
          </div>
          <div class="mb-3">
            <%= f.label :meeting_rules, class: "form-label" %>
            <%= f.text_area :meeting_rules, class: "form-control", rows: 2 %>
          </div>
          <div class="mb-4">
            <%= f.label :membership_rules, class: "form-label" %>
            <%= f.text_area :membership_rules, class: "form-control", rows: 2 %>
          </div>

          <hr class="my-4">
          <h2 class="h6 mb-3"><i class="bi bi-file-earmark-text me-1"></i> Terms &amp; Conditions</h2>
          <p class="text-muted small mb-3">Printed on every invoice you raise to your members.</p>
          <div class="mb-4">
            <%= f.text_area :terms_and_conditions, class: "form-control", rows: 4,
                  placeholder: "e.g. 1. Payment due within 7 days of invoice date.\n2. Fees once paid are non-refundable." %>
          </div>

          <h2 class="h6 mb-3"><i class="bi bi-bank me-1"></i> Banking Details</h2>
          <p class="text-muted small mb-3">Shown on member invoices so payments can be made by bank transfer.</p>
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
              <%= f.label :bank_name, class: "form-label" %>
              <%= f.text_field :bank_name, class: "form-control", placeholder: "e.g. HDFC Bank" %>
            </div>
            <div class="col-12 col-md-6">
              <%= f.label :bank_account_holder, "Account Holder Name", class: "form-label" %>
              <%= f.text_field :bank_account_holder, class: "form-control" %>
            </div>
          </div>
          <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
              <%= f.label :bank_account_number, "Account Number", class: "form-label" %>
              <%= f.text_field :bank_account_number, class: "form-control" %>
            </div>
            <div class="col-12 col-md-4">
              <%= f.label :bank_ifsc, "IFSC Code", class: "form-label" %>
              <%= f.text_field :bank_ifsc, class: "form-control text-uppercase" %>
            </div>
            <div class="col-12 col-md-4">
              <%= f.label :bank_branch, "Branch", class: "form-label" %>
              <%= f.text_field :bank_branch, class: "form-control" %>
            </div>
          </div>

          <h2 class="h6 mb-3"><i class="bi bi-qr-code me-1"></i> UPI &amp; QR Code</h2>
          <p class="text-muted small mb-3">Enter a UPI ID and it's automatically rendered as a scannable QR code on every invoice you raise to members.</p>
          <div class="row g-3 align-items-start mb-4">
            <div class="col-12 col-md-7">
              <%= f.label :upi_id, "UPI ID", class: "form-label" %>
              <%= f.text_field :upi_id, class: "form-control", placeholder: "e.g. forumname@okhdfcbank" %>
              <div class="form-text">Saved changes are reflected in the preview after you save.</div>
            </div>
            <% if @setting.upi_id.present? %>
              <div class="col-12 col-md-5 text-center">
                <div class="d-inline-block p-2 bg-white border rounded-3">
                  <%= upi_qr_code_svg(@setting.upi_id, payee_name: @setting.bank_account_holder.presence || @current_forum.name, size: 3) %>
                </div>
                <div class="text-muted small mt-1">Live preview</div>
              </div>
            <% end %>
          </div>

          <%= f.submit "Save Settings", class: "btn btn-primary btn-lg" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
