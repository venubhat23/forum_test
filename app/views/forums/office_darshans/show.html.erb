<% content_for :title, "Office Darshan · #{@darshan.host.display_name}" %>
<% new_flow = @attendances.present? %>

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
  <div>
    <h1 class="page-title h4">
      <% if new_flow %>
        <%= @darshan.host.display_name %> invites <%= @darshan.scope_chapter? ? @darshan.chapter&.name : (@darshan.scope_forum_wide? ? "the whole forum" : @darshan.visitor&.display_name) %>
      <% else %>
        <%= @darshan.host.display_name %> &rarr; <%= @darshan.visitor&.display_name %>
      <% end %>
    </h1>
    <p class="page-subtitle mb-0">
      <%= @darshan.scheduled_at.strftime("%d %b %Y %H:%M") %>
      <% if @darshan.venue.present? %> &middot; <i class="bi bi-geo-alt"></i> <%= @darshan.venue %><% end %>
      &middot; <span class="badge bg-secondary"><%= @darshan.status.titleize %></span>
    </p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <% unless new_flow %>
      <% if can?(:update, @darshan) && @darshan.invited? %>
        <%= button_to "Accept", accept_forum_office_darshan_path(forum_slug: @current_forum.slug, id: @darshan.id), method: :patch, class: "btn btn-success" %>
        <%= button_to "Decline", decline_forum_office_darshan_path(forum_slug: @current_forum.slug, id: @darshan.id), method: :patch, class: "btn btn-outline-danger" %>
      <% elsif can?(:complete, @darshan) && @darshan.accepted? %>
        <%= button_to "Mark Successfully Visited", complete_forum_office_darshan_path(forum_slug: @current_forum.slug, id: @darshan.id), method: :patch, class: "btn btn-primary" %>
      <% end %>
      <% if @darshan.completed? && can?(:thank, @darshan) %>
        <%= button_to "Send Thank You", thank_forum_office_darshan_path(forum_slug: @current_forum.slug, id: @darshan.id), method: :patch, class: "btn btn-outline-success" %>
      <% end %>
    <% else %>
      <% if can?(:schedule, @darshan) && @darshan.invited? %>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#scheduleModal">
          <i class="bi bi-calendar-check me-1"></i> Schedule Visit
        </button>
      <% end %>
      <% if can?(:complete, @darshan) && @darshan.scheduled? %>
        <%= button_to complete_forum_office_darshan_path(forum_slug: @current_forum.slug, id: @darshan.id), method: :patch, class: "btn btn-success" do %>
          <i class="bi bi-check-circle me-1"></i> Mark Complete
        <% end %>
      <% end %>
    <% end %>
    <% if can? :destroy, @darshan %>
      <%= button_to "Delete", forum_office_darshan_path(forum_slug: @current_forum.slug, id: @darshan.id), method: :delete, class: "btn btn-outline-danger",
            data: { turbo_confirm: "Delete this visit record?" } %>
    <% end %>
  </div>
</div>

<% if new_flow %>
  <%= render "flow_stepper", darshan: @darshan %>
<% end %>

<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6">
    <div class="card h-100">
      <div class="card-header fw-semibold">Host / Organizer</div>
      <div class="card-body d-flex align-items-center gap-2">
        <span class="row-avatar"><%= @darshan.host.display_name.first.upcase %></span>
        <span><%= @darshan.host.display_name %></span>
      </div>
    </div>
  </div>
  <div class="col-12 col-sm-6">
    <div class="card h-100">
      <div class="card-header fw-semibold">Invited</div>
      <div class="card-body d-flex align-items-center gap-2">
        <% if @darshan.scope_member? %>
          <span class="row-avatar"><%= @darshan.visitor&.display_name&.first&.upcase %></span>
          <span><%= @darshan.visitor&.display_name %></span>
        <% elsif @darshan.scope_chapter? %>
          <i class="bi bi-diagram-3 fs-5 text-primary"></i>
          <span>Entire Chapter &middot; <%= @darshan.chapter&.name %> (<%= @darshan.attendances.count %> members)</span>
        <% else %>
          <i class="bi bi-building fs-5 text-primary"></i>
          <span>Entire Forum &middot; <%= @current_forum.name %> (<%= @darshan.attendances.count %> members)</span>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if new_flow %>
  <% if can?(:remind, @darshan) %>
    <div class="card mb-4">
      <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="fw-semibold">
          Attendee List &middot;
          <span class="text-success"><%= @darshan.coming_count %> coming</span> &middot;
          <span class="text-warning"><%= @darshan.pending_count %> pending</span> &middot;
          <span class="text-secondary"><%= @darshan.declined_count %> declined</span>
        </span>
        <%= button_to remind_forum_office_darshan_path(forum_slug: @current_forum.slug, id: @darshan.id), method: :post, class: "btn btn-sm btn-outline-primary" do %>
          <i class="bi bi-bell me-1"></i> Send Reminder Now
        <% end %>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Member</th>
              <th>RSVP</th>
              <% if @darshan.completed? %><th>Attended</th><th>Review</th><% end %>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @attendances.each do |a| %>
              <tr>
                <td class="d-flex align-items-center gap-2">
                  <span class="row-avatar"><%= a.user.display_name.first.upcase %></span>
                  <span class="fw-semibold"><%= a.user.display_name %></span>
                </td>
                <td><span class="badge <%= rsvp_badge_class(a.rsvp_status) %>"><%= a.rsvp_status.titleize %></span></td>
                <% if @darshan.completed? %>
                  <td><% if a.attended? %><i class="bi bi-check-lg text-success"></i><% end %></td>
                  <td>
                    <% if a.reviewed? %>
                      <span title="<%= a.review_comment %>"><%= "★" * a.rating.to_i %><span class="text-muted"><%= "☆" * (5 - a.rating.to_i) %></span></span>
                    <% end %>
                  </td>
                <% end %>
                <td class="text-end">
                  <% if a.invited? && (link = whatsapp_darshan_reminder_link(@darshan, a.user)) %>
                    <%= link_to link, class: "icon-btn icon-btn-whatsapp", title: "WhatsApp nudge", target: "_blank", rel: "noopener", allow_other_host: true do %>
                      <i class="bi bi-whatsapp"></i>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="modal fade" id="scheduleModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <%= form_with model: @darshan, url: schedule_forum_office_darshan_path(forum_slug: @current_forum.slug, id: @darshan.id), method: :patch, local: true do |f| %>
            <div class="modal-header">
              <h5 class="modal-title">Schedule Office Darshan Visit</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="mb-3">
                <%= f.label :scheduled_at, "Final Date & Time", class: "form-label" %>
                <%= f.datetime_field :scheduled_at, value: @darshan.scheduled_at, class: "form-control", required: true %>
              </div>
              <div class="mb-3">
                <%= f.label :venue, class: "form-label" %>
                <%= f.text_field :venue, value: @darshan.venue, class: "form-control", placeholder: "Office address" %>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <%= f.submit "Lock In Schedule", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @my_attendance&.invited? %>
    <div class="card mb-4 border-primary">
      <div class="card-body text-center py-4">
        <h5 class="mb-1"><i class="bi bi-envelope-heart text-primary me-1"></i> You're invited to an office darshan visit!</h5>
        <p class="text-muted mb-3"><%= @darshan.scheduled_at.strftime("%d %b %Y at %H:%M") %><% if @darshan.venue.present? %> &middot; <%= @darshan.venue %><% end %></p>
        <div class="d-flex justify-content-center gap-2">
          <%= button_to rsvp_forum_office_darshan_attendance_path(forum_slug: @current_forum.slug, office_darshan_id: @darshan.id, id: @my_attendance.id), method: :patch, params: { rsvp_status: "coming" }, class: "btn btn-success btn-lg" do %>
            <i class="bi bi-hand-thumbs-up me-1"></i> I'm Coming
          <% end %>
          <%= button_to rsvp_forum_office_darshan_attendance_path(forum_slug: @current_forum.slug, office_darshan_id: @darshan.id, id: @my_attendance.id), method: :patch, params: { rsvp_status: "not_coming" }, class: "btn btn-outline-secondary btn-lg" do %>
            Can't Make It
          <% end %>
        </div>
      </div>
    </div>
  <% elsif @my_attendance && !@darshan.completed? %>
    <p class="text-muted small">
      Your RSVP: <span class="badge <%= rsvp_badge_class(@my_attendance.rsvp_status) %>"><%= @my_attendance.rsvp_status.titleize %></span>
      <%= button_to "Change to Coming", rsvp_forum_office_darshan_attendance_path(forum_slug: @current_forum.slug, office_darshan_id: @darshan.id, id: @my_attendance.id), method: :patch, params: { rsvp_status: "coming" }, class: "btn btn-link btn-sm p-0 ms-2" if @my_attendance.not_coming? %>
    </p>
  <% end %>

  <% if @darshan.completed? && @my_attendance&.attended? %>
    <div class="card mb-4">
      <div class="card-header fw-semibold">
        <i class="bi bi-star me-1"></i> <%= @my_attendance.reviewed? ? "Your Review" : "Leave a Review" %>
      </div>
      <div class="card-body">
        <% if @my_attendance.reviewed? %>
          <p class="mb-1"><%= "★" * @my_attendance.rating.to_i %><span class="text-muted"><%= "☆" * (5 - @my_attendance.rating.to_i) %></span></p>
          <p class="text-muted mb-0"><%= @my_attendance.review_comment %></p>
        <% else %>
          <%= form_with model: @my_attendance, url: review_forum_office_darshan_attendance_path(forum_slug: @current_forum.slug, office_darshan_id: @darshan.id, id: @my_attendance.id), method: :patch, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :rating, class: "form-label" %>
              <%= f.select :rating, (1..5).to_a.reverse.map { |n| [ "#{n} ★", n ] }, { include_blank: "Select rating" }, class: "form-select", required: true %>
            </div>
            <div class="mb-3">
              <%= f.label :review_comment, "Suggestion / Feedback", class: "form-label" %>
              <%= f.text_area :review_comment, class: "form-control", rows: 3 %>
            </div>
            <%= f.submit "Submit Review", class: "btn btn-primary" %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<% if @darshan.confirmed_at.present? || @darshan.thanked_at.present? %>
  <p class="text-muted small">
    <% if @darshan.confirmed_at.present? %>Confirmed <%= @darshan.confirmed_at.strftime("%d %b %Y %H:%M") %><% end %>
    <% if @darshan.thanked_at.present? %> &middot; Thank-you sent <%= @darshan.thanked_at.strftime("%d %b %Y %H:%M") %><% end %>
  </p>
<% end %>

<% if @darshan.photos.attached? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Photos</div>
    <div class="card-body d-flex flex-wrap gap-2">
      <% @darshan.photos.each do |photo| %>
        <%= link_to photo.filename, rails_blob_path(photo, disposition: "attachment") %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @darshan.notes.present? %>
  <div class="card">
    <div class="card-header fw-semibold">Notes</div>
    <div class="card-body"><%= simple_format(@darshan.notes) %></div>
  </div>
<% end %>
