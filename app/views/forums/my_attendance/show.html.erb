<% content_for :title, "My Attendance" %>

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
  <div>
    <h1 class="page-title h4">My Attendance</h1>
    <p class="page-subtitle mb-0">Your upcoming meetings, events, one-to-ones and office darshan visits &mdash; mark yourself present as they happen.</p>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header fw-semibold">Weekly Meetings</div>
  <div class="card-body">
    <% if @upcoming_meetings.empty? %>
      <p class="text-muted mb-0">No upcoming meetings scheduled for your chapter.</p>
    <% else %>
      <ul class="list-group list-group-flush">
        <% @upcoming_meetings.each do |meeting| %>
          <% attendance = @meeting_attendances[meeting.id] %>
          <% is_today = meeting.scheduled_at.to_date == Date.current %>
          <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 px-0">
            <div>
              <div class="fw-semibold"><%= meeting.meeting_type.titleize %> Meeting</div>
              <div class="text-muted small">
                <%= meeting.scheduled_at.strftime("%d %b %Y %H:%M") %>
                <% if meeting.venue.present? %> &middot; <%= meeting.venue %><% end %>
              </div>
            </div>
            <% if attendance&.attended? %>
              <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>You're marked attended</span>
            <% elsif !is_today %>
              <span class="badge bg-secondary-subtle text-secondary-emphasis">Scheduled &mdash; check in on the day</span>
            <% else %>
              <div class="d-flex align-items-center gap-2">
                <% if attendance&.attending? %>
                  <span class="badge bg-info text-dark"><i class="bi bi-clock me-1"></i>Marked attending &middot; awaiting admin confirmation</span>
                <% elsif attendance&.absent? %>
                  <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Marked not attending</span>
                <% end %>
                <% unless attendance&.attending? %>
                  <%= button_to "Yes, I'm Attending", check_in_forum_chapter_meeting_path(forum_slug: @current_forum.slug, chapter_id: meeting.chapter_id, id: meeting.id),
                        method: :post, params: { attending: "1" }, class: "btn btn-success btn-sm" %>
                <% end %>
                <% unless attendance&.absent? %>
                  <%= button_to "No, Not Attending", check_in_forum_chapter_meeting_path(forum_slug: @current_forum.slug, chapter_id: meeting.chapter_id, id: meeting.id),
                        method: :post, params: { attending: "0" }, class: "btn btn-outline-danger btn-sm" %>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header fw-semibold">Events</div>
  <div class="card-body">
    <% if @upcoming_registrations.empty? %>
      <p class="text-muted mb-0">No upcoming events you're registered for.</p>
    <% else %>
      <ul class="list-group list-group-flush">
        <% @upcoming_registrations.each do |registration| %>
          <% is_today = registration.event.starts_at.to_date == Date.current %>
          <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 px-0">
            <div>
              <div class="fw-semibold"><%= registration.event.title %></div>
              <div class="text-muted small"><%= registration.event.starts_at.strftime("%d %b %Y %H:%M") %></div>
            </div>
            <% if registration.attended? %>
              <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>You're marked present</span>
            <% elsif is_today %>
              <%= button_to "Mark My Attendance", check_in_forum_event_path(forum_slug: @current_forum.slug, id: registration.event_id), method: :post, class: "btn btn-primary btn-sm" %>
            <% else %>
              <span class="badge bg-secondary-subtle text-secondary-emphasis">Registered &mdash; check in on the day</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header fw-semibold">One-to-One Meetings</div>
  <div class="card-body">
    <% if @upcoming_one_to_ones.empty? %>
      <p class="text-muted mb-0">No upcoming one-to-one meetings.</p>
    <% else %>
      <ul class="list-group list-group-flush">
        <% @upcoming_one_to_ones.each do |otm| %>
          <% other_party = otm.requester_id == current_user.id ? otm.requested_with : otm.requester %>
          <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 px-0">
            <div>
              <div class="fw-semibold">With <%= other_party.display_name %></div>
              <div class="text-muted small"><%= otm.scheduled_at.strftime("%d %b %Y %H:%M") %></div>
            </div>
            <div class="d-flex align-items-center gap-2">
              <% if otm.requested? && otm.requested_with_id == current_user.id %>
                <%= button_to "Accept", accept_forum_one_to_one_meeting_path(forum_slug: @current_forum.slug, id: otm.id), method: :patch, class: "btn btn-success btn-sm" %>
                <%= button_to "Reject", reject_forum_one_to_one_meeting_path(forum_slug: @current_forum.slug, id: otm.id), method: :patch, class: "btn btn-outline-danger btn-sm" %>
              <% elsif otm.requested? %>
                <span class="badge bg-secondary-subtle text-secondary-emphasis">Awaiting their response</span>
              <% elsif otm.accepted? %>
                <%= link_to "Mark Attended / Complete", forum_one_to_one_meeting_path(forum_slug: @current_forum.slug, id: otm.id), class: "btn btn-primary btn-sm" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header fw-semibold">Office Darshan</div>
  <div class="card-body">
    <% if @upcoming_darshan_attendances.empty? && @hosted_darshans.empty? %>
      <p class="text-muted mb-0">No upcoming office darshan visits.</p>
    <% else %>
      <ul class="list-group list-group-flush">
        <% @upcoming_darshan_attendances.each do |attendance| %>
          <% darshan = attendance.office_darshan %>
          <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 px-0">
            <div>
              <div class="fw-semibold">Visit <%= darshan.host.display_name %>'s office</div>
              <div class="text-muted small"><%= darshan.scheduled_at.strftime("%d %b %Y %H:%M") %></div>
            </div>
            <div class="d-flex align-items-center gap-2">
              <% if attendance.attended? %>
                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>You're marked attended</span>
              <% elsif darshan.completed? %>
                <%= button_to "Mark Attended", mark_attended_forum_office_darshan_attendance_path(forum_slug: @current_forum.slug, office_darshan_id: darshan.id, id: attendance.id), method: :patch, class: "btn btn-primary btn-sm" %>
              <% elsif attendance.invited? %>
                <%= button_to "Coming", rsvp_forum_office_darshan_attendance_path(forum_slug: @current_forum.slug, office_darshan_id: darshan.id, id: attendance.id), method: :patch, params: { rsvp_status: "coming" }, class: "btn btn-success btn-sm" %>
                <%= button_to "Not Coming", rsvp_forum_office_darshan_attendance_path(forum_slug: @current_forum.slug, office_darshan_id: darshan.id, id: attendance.id), method: :patch, params: { rsvp_status: "not_coming" }, class: "btn btn-outline-danger btn-sm" %>
              <% else %>
                <span class="badge bg-secondary-subtle text-secondary-emphasis"><%= attendance.rsvp_status.titleize %> &mdash; not yet completed</span>
              <% end %>
            </div>
          </li>
        <% end %>
        <% @hosted_darshans.each do |darshan| %>
          <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 px-0">
            <div>
              <div class="fw-semibold">Hosting a visit &middot; <%= darshan.status.titleize %></div>
              <div class="text-muted small"><%= darshan.scheduled_at.strftime("%d %b %Y %H:%M") %></div>
            </div>
            <%= link_to "Manage", forum_office_darshan_path(forum_slug: @current_forum.slug, id: darshan.id), class: "btn btn-outline-secondary btn-sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-header fw-semibold">Recent Attendance History</div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Date</th>
          <th>Type</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_attendances.each do |attendance| %>
          <tr>
            <td><%= attendance.occurred_on.strftime("%d %b %Y") %></td>
            <td><%= attendance.event_type.titleize %></td>
            <td>
              <% if attendance.meeting? %>
                <% if attendance.attended? %>
                  <span class="badge bg-success">Attended</span>
                <% elsif attendance.attending? %>
                  <span class="badge bg-info text-dark">Attending</span>
                <% else %>
                  <span class="badge bg-danger">Absent</span>
                <% end %>
              <% elsif attendance.present? %>
                <span class="badge bg-success">Present</span>
              <% else %>
                <span class="badge bg-danger">Absent</span>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @recent_attendances.empty? %>
          <tr><td colspan="3" class="text-center text-muted py-4">No attendance recorded yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
