<% content_for :title, "One-to-One Meeting" %>

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
  <div>
    <h1 class="page-title h4"><%= @meeting.requester.display_name %> &rarr; <%= @meeting.requested_with.display_name %></h1>
    <p class="page-subtitle mb-0"><%= @meeting.scheduled_at.strftime("%d %b %Y %H:%M") %> &middot; <span class="badge bg-secondary"><%= @meeting.status.titleize %></span></p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <% if can?(:update, @meeting) && @meeting.requested? %>
      <%= button_to "Accept", accept_forum_one_to_one_meeting_path(forum_slug: @current_forum.slug, id: @meeting.id), method: :patch, class: "btn btn-success" %>
      <%= button_to "Reject", reject_forum_one_to_one_meeting_path(forum_slug: @current_forum.slug, id: @meeting.id), method: :patch, class: "btn btn-outline-danger" %>
    <% elsif can?(:thank, @meeting) && @meeting.completed? && @meeting.notes.present? && @meeting.thanked_at.blank? %>
      <%= button_to "Send Thank You", thank_forum_one_to_one_meeting_path(forum_slug: @current_forum.slug, id: @meeting.id), method: :patch, class: "btn btn-outline-success" %>
    <% end %>
    <% if can? :destroy, @meeting %>
      <%= button_to "Cancel Meeting", forum_one_to_one_meeting_path(forum_slug: @current_forum.slug, id: @meeting.id), method: :delete, class: "btn btn-outline-danger",
            data: { turbo_confirm: "Cancel this meeting?" } %>
    <% end %>
  </div>
</div>

<%= render "flow_stepper", meeting: @meeting %>

<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6">
    <div class="card h-100">
      <div class="card-header fw-semibold">Requester</div>
      <div class="card-body d-flex align-items-center gap-2">
        <span class="row-avatar"><%= @meeting.requester.display_name.first.upcase %></span>
        <span><%= @meeting.requester.display_name %></span>
      </div>
    </div>
  </div>
  <div class="col-12 col-sm-6">
    <div class="card h-100">
      <div class="card-header fw-semibold">Meeting With</div>
      <div class="card-body d-flex align-items-center gap-2">
        <span class="row-avatar"><%= @meeting.requested_with.display_name.first.upcase %></span>
        <span><%= @meeting.requested_with.display_name %></span>
      </div>
    </div>
  </div>
</div>

<% if @meeting.thanked_at.present? %>
  <p class="text-muted small">Thank-you sent <%= @meeting.thanked_at.strftime("%d %b %Y %H:%M") %></p>
<% end %>

<% if @meeting.accepted? && can?(:complete, @meeting) %>
  <div class="card mb-4 border-primary">
    <div class="card-header fw-semibold"><i class="bi bi-flag-fill me-1"></i>Complete Meeting</div>
    <div class="card-body">
      <%= form_with model: @meeting, url: complete_forum_one_to_one_meeting_path(forum_slug: @current_forum.slug, id: @meeting.id), method: :patch, local: true, data: { controller: "fee-toggle" } do |f| %>
        <div class="form-check mb-2">
          <%= f.check_box :business_generated, class: "form-check-input", data: { action: "fee-toggle#toggle", "fee-toggle-target": "checkbox" } %>
          <%= f.label :business_generated, "Any business generated from this meeting?", class: "form-check-label" %>
        </div>
        <div class="mb-3 <%= "d-none" unless @meeting.business_generated? %>" data-fee-toggle-target="amountWrap">
          <%= f.label :business_generated_amount, "Business Amount", class: "form-label" %>
          <%= f.number_field :business_generated_amount, step: "0.01", min: "0.01", class: "form-control", style: "max-width: 220px;",
                data: { "fee-toggle-target": "amountField" } %>
        </div>
        <%= f.submit "Mark Completed", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @meeting.business_generated? %>
  <div class="card mb-4 border-success">
    <div class="card-body d-flex align-items-center gap-2 text-success">
      <i class="bi bi-graph-up-arrow"></i>
      <span>Business generated: <strong><%= number_to_currency(@meeting.business_generated_amount) %></strong></span>
    </div>
  </div>
<% end %>

<% if @meeting.venue.present? || @meeting.agenda.present? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Venue &amp; Agenda</div>
    <div class="card-body">
      <% if @meeting.venue.present? %>
        <p class="mb-2"><i class="bi bi-geo-alt me-1"></i><strong>Venue:</strong> <%= @meeting.venue %></p>
      <% end %>
      <% if @meeting.agenda.present? %>
        <div><strong>Agenda</strong><%= simple_format(@meeting.agenda) %></div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @meeting.completed? && can?(:complete, @meeting) && @meeting.notes.blank? %>
  <div class="card mb-4 border-primary">
    <div class="card-header fw-semibold"><i class="bi bi-journal-text me-1"></i>Add Meeting Notes</div>
    <div class="card-body">
      <p class="text-muted small">Wrap up this meeting with a quick note on what was discussed before sending a thank-you.</p>
      <%= form_with model: @meeting, url: add_note_forum_one_to_one_meeting_path(forum_slug: @current_forum.slug, id: @meeting.id), method: :patch, local: true do |f| %>
        <div class="mb-3">
          <%= f.text_area :notes, class: "form-control", rows: 3, required: true, placeholder: "What was discussed? Any follow-ups?" %>
        </div>
        <%= f.submit "Save Notes", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
<% elsif @meeting.notes.present? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Meeting Notes</div>
    <div class="card-body"><%= simple_format(@meeting.notes) %></div>
  </div>
<% end %>

<% if @meeting.thanked_at.present? %>
  <div class="card mb-4 border-success">
    <div class="card-body d-flex align-items-center gap-2 text-success">
      <i class="bi bi-heart-fill"></i>
      <span>Thank-you sent &mdash; this meeting is all wrapped up. 🤝</span>
    </div>
  </div>
<% end %>

<% if @meeting.fee_amount.present? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Fee &amp; Payment Info</div>
    <div class="card-body">
      <p class="mb-3">Fee: <strong><%= number_to_currency(@meeting.fee_amount) %></strong></p>
      <% fee = @meeting.fee_payments.order(:created_at).find_by(user_id: @meeting.requested_with_id) %>
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><%= @meeting.requested_with.display_name %></span>
        <div class="d-flex align-items-center gap-2">
          <% if fee&.paid? %>
            <span class="badge badge-status-active"><i class="bi bi-check-circle-fill me-1"></i>Paid</span>
          <% elsif fee&.partially_paid? %>
            <span class="badge badge-status-partial"><i class="bi bi-exclamation-triangle-fill me-1"></i>Partially Paid</span>
          <% elsif fee.nil? && @meeting.requested_with.annual_fee_paid? %>
            <span class="badge badge-status-active" title="Annual membership fee is already paid — no meeting fee is collected"><i class="bi bi-shield-check me-1"></i>Waived · Annual Member</span>
          <% else %>
            <span class="badge badge-status-trial"><i class="bi bi-exclamation-circle-fill me-1"></i>Due</span>
          <% end %>
          <% if can?(:update, @meeting) %>
            <% if fee && !fee.paid? %>
              <%= button_to mark_paid_forum_chapter_fee_payment_path(forum_slug: @current_forum.slug, chapter_id: @meeting.requested_with.chapter_id, id: fee.id), method: :patch, class: "icon-btn icon-btn-success", title: "Mark Paid (full balance)" do %>
                <i class="bi bi-check-lg"></i>
              <% end %>
            <% elsif fee.nil? && @meeting.requested_with.annual_fee_paid? %>
              <%# annual dues already cover this member — no fee to record %>
            <% elsif fee.nil? && @meeting.requested_with.chapter_id.present? %>
              <%= link_to new_forum_chapter_fee_payment_path(forum_slug: @current_forum.slug, chapter_id: @meeting.requested_with.chapter_id, user_id: @meeting.requested_with.id, fee_type: "meeting", one_to_one_meeting_id: @meeting.id), class: "icon-btn icon-btn-view", title: "Record Fee" do %>
                <i class="bi bi-cash-coin"></i>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
