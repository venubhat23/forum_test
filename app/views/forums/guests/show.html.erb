<% content_for :title, @guest.display_name %>

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
  <div>
    <h1 class="page-title h4"><%= @guest.display_name %></h1>
    <p class="page-subtitle mb-0"><%= @chapter.name %> &middot; <%= @guest.email %></p>
  </div>
  <% if can? :update, @guest %>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Edit", edit_forum_chapter_guest_path(forum_slug: @current_forum.slug, chapter_id: @chapter.id, id: @guest.id), class: "btn btn-outline-secondary" %>
      <% if (profile_link = whatsapp_profile_form_link(@guest, @current_forum)) %>
        <%= link_to profile_link, class: "btn btn-outline-success", target: "_blank", rel: "noopener" do %>
          <i class="bi bi-whatsapp me-1"></i> Ask to Fill Profile
        <% end %>
      <% end %>
      <%= link_to convert_forum_chapter_guest_path(forum_slug: @current_forum.slug, chapter_id: @chapter.id, id: @guest.id), class: "btn btn-success" do %>
        <i class="bi bi-arrow-right-circle me-1"></i> Convert to Member
      <% end %>
      <%= button_to "Delete", forum_chapter_guest_path(forum_slug: @current_forum.slug, chapter_id: @chapter.id, id: @guest.id), method: :delete, class: "btn btn-outline-danger",
            data: { turbo_confirm: "Remove #{@guest.display_name}?" } %>
    </div>
  <% end %>
</div>

<% if @guest.profile_submitted_at.present? %>
  <div class="alert alert-success d-flex align-items-center gap-2 mt-3 mb-0" role="alert">
    <i class="bi bi-person-check fs-5"></i>
    <div><%= @guest.display_name %> filled in their own profile on <%= @guest.profile_submitted_at.strftime("%d %b %Y at %I:%M %p") %>. It'll be ready to review on the Convert page.</div>
  </div>
<% end %>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-4">
    <div class="stats-card">
      <div class="icon-bg gradient-blue"><i class="bi bi-calendar-check"></i></div>
      <div>
        <div class="stats-value"><%= @visit_count %></div>
        <div class="stats-label">Visits</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-4">
    <div class="stats-card">
      <div class="icon-bg gradient-purple"><i class="bi bi-person-heart"></i></div>
      <div>
        <div class="stats-value h6 mb-0"><%= @guest.invited_by_display || "&mdash;".html_safe %></div>
        <div class="stats-label">Invited By</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-4">
    <div class="stats-card">
      <div class="icon-bg gradient-green"><i class="bi bi-calendar3"></i></div>
      <div>
        <div class="stats-value h6 mb-0"><%= @guest.created_at.strftime("%d %b %Y") %></div>
        <div class="stats-label">First Added</div>
      </div>
    </div>
  </div>
</div>

<% if @guest.photo.attached? || @guest.company_logo.attached? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Photos</div>
    <div class="card-body d-flex flex-wrap gap-4">
      <% if @guest.photo.attached? %>
        <div>
          <div class="text-muted small mb-1">Photo</div>
          <%= image_tag @guest.photo, style: "height: 140px; border-radius: 8px; object-fit: cover;" %>
        </div>
      <% end %>
      <% if @guest.company_logo.attached? %>
        <div>
          <div class="text-muted small mb-1">Company Logo</div>
          <%= image_tag @guest.company_logo, style: "height: 140px; border-radius: 8px; object-fit: cover;" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @guest_meeting_fees.present? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Meeting Fees</div>
    <div class="list-group list-group-flush">
      <% @guest_meeting_fees.each do |fee| %>
        <% meeting = fee.feeable %>
        <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span>
            <%= meeting&.topic.presence || meeting&.meeting_type&.titleize || "Meeting" %>
            <% if meeting %> &middot; <%= meeting.scheduled_at.strftime("%d %b %Y") %><% end %>
            &middot; <%= number_to_currency(fee.amount) %>
          </span>
          <div class="d-flex align-items-center gap-2">
            <% if fee.paid? %>
              <span class="badge badge-status-active"><i class="bi bi-check-circle-fill me-1"></i>Paid</span>
            <% elsif fee.partially_paid? %>
              <span class="badge badge-status-partial"><i class="bi bi-exclamation-triangle-fill me-1"></i>Partially Paid</span>
            <% else %>
              <span class="badge badge-status-trial"><i class="bi bi-exclamation-circle-fill me-1"></i>Due</span>
            <% end %>
            <% if !fee.paid? && (wa_link = whatsapp_item_fee_reminder_link(@guest, fee, meeting&.topic.presence || "the meeting", @current_forum)) %>
              <%= link_to wa_link, class: "icon-btn icon-btn-whatsapp", title: "Remind to pay via WhatsApp", target: "_blank", rel: "noopener" do %>
                <i class="bi bi-whatsapp"></i>
              <% end %>
            <% end %>
            <% if !fee.paid? %>
              <%= button_to mark_paid_forum_chapter_fee_payment_path(forum_slug: @current_forum.slug, chapter_id: @chapter.id, id: fee.id), method: :patch, class: "icon-btn icon-btn-success", title: "Mark Paid (full balance)" do %>
                <i class="bi bi-check-lg"></i>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @guest.meeting_fee_paid? || @guest.meeting_fee_screenshot.attached? %>
  <div class="card mb-4">
    <div class="card-header fw-semibold">Meeting Fee (Self-Reported)</div>
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
      <span class="badge <%= @guest.meeting_fee_paid? ? "bg-success" : "bg-secondary" %>">
        <i class="bi <%= @guest.meeting_fee_paid? ? "bi-check-circle" : "bi-x-circle" %> me-1"></i>
        <%= @guest.meeting_fee_paid? ? "Reported as paid" : "Reported as not paid" %>
      </span>
      <% if @guest.meeting_fee_screenshot.attached? %>
        <a href="<%= rails_blob_path(@guest.meeting_fee_screenshot) %>" target="_blank" rel="noopener">
          <%= image_tag @guest.meeting_fee_screenshot, style: "height: 100px; border-radius: 8px; object-fit: cover;", alt: "Payment screenshot" %>
        </a>
      <% end %>
    </div>
  </div>
<% end %>

<div class="card mb-4">
  <div class="card-header fw-semibold">Profile</div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Phone</dt><dd class="col-sm-9"><%= @guest.phone %></dd>
      <dt class="col-sm-3">Date of Birth</dt><dd class="col-sm-9"><%= @guest.date_of_birth&.strftime("%d %b %Y") || "—" %></dd>
      <dt class="col-sm-3">Nature of Business</dt><dd class="col-sm-9"><%= @guest.nature_of_business.presence || "—" %></dd>
      <dt class="col-sm-3">Business Name</dt><dd class="col-sm-9"><%= @guest.business_name.presence || "—" %></dd>
      <dt class="col-sm-3">Business Category</dt><dd class="col-sm-9"><%= (@guest.business_category_id ? @guest.business_category_ref&.name : @guest.business_category).presence || "—" %></dd>
      <dt class="col-sm-3">Speciality</dt><dd class="col-sm-9"><%= @guest.speciality.presence || "—" %></dd>
      <dt class="col-sm-3">Website</dt>
      <dd class="col-sm-9">
        <% if @guest.website.present? %>
          <%= link_to @guest.website, external_url(@guest.website), target: "_blank", rel: "noopener" %>
        <% else %>
          <%= link_to forum_website_url(forum_slug: @current_forum.slug), forum_website_url(forum_slug: @current_forum.slug), target: "_blank", rel: "noopener" %>
          <span class="text-muted small d-block">No personal website on file — showing <%= @current_forum.name %>'s website</span>
        <% end %>
      </dd>
      <dt class="col-sm-3">Business Capacity</dt><dd class="col-sm-9"><%= @guest.capacity.presence || "—" %></dd>
      <dt class="col-sm-3">Service Coverage Area</dt><dd class="col-sm-9"><%= @guest.service_area.presence || "—" %></dd>
      <dt class="col-sm-3">Address</dt><dd class="col-sm-9"><%= @guest.address.presence || "—" %></dd>
      <dt class="col-sm-3">Location (City)</dt><dd class="col-sm-9"><%= @guest.city.presence || "—" %></dd>
      <dt class="col-sm-3">Social Media</dt><dd class="col-sm-9"><%= @guest.social_media_handle.presence || "—" %></dd>
    </dl>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header fw-semibold">Statutory Details</div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">GST Number</dt><dd class="col-sm-9"><%= @guest.gst_number.presence || "—" %></dd>
      <dt class="col-sm-3">PAN Number</dt><dd class="col-sm-9"><%= @guest.pan_number.presence || "—" %></dd>
      <dt class="col-sm-3">Aadhaar Number</dt><dd class="col-sm-9"><%= @guest.aadhaar_number.presence || "—" %></dd>
    </dl>
  </div>
</div>

<div class="card">
  <div class="card-header fw-semibold">Uploaded Documents</div>
  <div class="list-group list-group-flush">
    <% if @guest.gst_document.attached? %>
      <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="d-flex align-items-center gap-2">
          <% if @guest.gst_document.image? %>
            <%= link_to @guest.gst_document, target: "_blank", rel: "noopener" do %>
              <%= image_tag @guest.gst_document, style: "height: 48px; width: 48px; border-radius: 6px; object-fit: cover;", alt: "GST Certificate" %>
            <% end %>
          <% else %>
            <i class="bi bi-file-earmark-text"></i>
          <% end %>
          GST Certificate
        </span>
        <%= link_to "View", rails_blob_path(@guest.gst_document, disposition: "attachment"), class: "btn btn-sm btn-outline-secondary" %>
      </div>
    <% end %>
    <% if @guest.pan_document.attached? %>
      <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="d-flex align-items-center gap-2">
          <% if @guest.pan_document.image? %>
            <%= link_to @guest.pan_document, target: "_blank", rel: "noopener" do %>
              <%= image_tag @guest.pan_document, style: "height: 48px; width: 48px; border-radius: 6px; object-fit: cover;", alt: "PAN Card" %>
            <% end %>
          <% else %>
            <i class="bi bi-file-earmark-text"></i>
          <% end %>
          PAN Card
        </span>
        <%= link_to "View", rails_blob_path(@guest.pan_document, disposition: "attachment"), class: "btn btn-sm btn-outline-secondary" %>
      </div>
    <% end %>
    <% if @guest.aadhaar_document.attached? %>
      <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="d-flex align-items-center gap-2">
          <% if @guest.aadhaar_document.image? %>
            <%= link_to @guest.aadhaar_document, target: "_blank", rel: "noopener" do %>
              <%= image_tag @guest.aadhaar_document, style: "height: 48px; width: 48px; border-radius: 6px; object-fit: cover;", alt: "Aadhaar Card" %>
            <% end %>
          <% else %>
            <i class="bi bi-file-earmark-text"></i>
          <% end %>
          Aadhaar Card
        </span>
        <%= link_to "View", rails_blob_path(@guest.aadhaar_document, disposition: "attachment"), class: "btn btn-sm btn-outline-secondary" %>
      </div>
    <% end %>
    <% @guest.kyc_documents.each do |doc| %>
      <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="d-flex align-items-center gap-2">
          <% if doc.image? %>
            <%= link_to doc, target: "_blank", rel: "noopener" do %>
              <%= image_tag doc, style: "height: 48px; width: 48px; border-radius: 6px; object-fit: cover;", alt: doc.filename.to_s %>
            <% end %>
          <% else %>
            <i class="bi bi-file-earmark"></i>
          <% end %>
          <%= doc.filename %>
        </span>
        <%= link_to "View", rails_blob_path(doc, disposition: "attachment"), class: "btn btn-sm btn-outline-secondary" %>
      </div>
    <% end %>
    <% unless @guest.gst_document.attached? || @guest.pan_document.attached? || @guest.aadhaar_document.attached? || @guest.kyc_documents.attached? %>
      <div class="list-group-item text-muted text-center py-3">No documents uploaded yet.</div>
    <% end %>
  </div>
</div>
