<% content_for :title, "Guests · #{@current_forum.name}" %>

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
  <div>
    <h1 class="page-title h4">Guests</h1>
    <p class="page-subtitle mb-0">
      <% if current_user.chapter_admin? %>
        Guests in <%= current_user.chapter&.name %>
      <% else %>
        All guests across <%= @current_forum.name %>
      <% end %>
    </p>
  </div>
  <% if current_user.chapter_admin? %>
    <%= link_to new_forum_chapter_guest_path(forum_slug: @current_forum.slug, chapter_id: current_user.chapter_id), class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i> Add Guest
    <% end %>
  <% else %>
    <div class="dropdown">
      <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-plus-lg me-1"></i> Add Guest
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><h6 class="dropdown-header">Choose a chapter</h6></li>
        <% @current_forum.chapters.active.order(:name).each do |chapter| %>
          <li><%= link_to chapter.name, new_forum_chapter_guest_path(forum_slug: @current_forum.slug, chapter_id: chapter.id), class: "dropdown-item" %></li>
        <% end %>
        <% if @current_forum.chapters.active.none? %>
          <li><span class="dropdown-item-text text-muted">No active chapters yet</span></li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-6">
    <div class="mini-stat-card">
      <div>
        <div class="mini-stat-label">Total Guests</div>
        <div class="mini-stat-value text-primary"><%= @total_guests %></div>
      </div>
      <div class="mini-stat-icon mini-stat-icon-primary"><i class="bi bi-person-badge"></i></div>
    </div>
  </div>
  <div class="col-6 col-lg-6">
    <div class="mini-stat-card">
      <div>
        <div class="mini-stat-label">Invited This Month</div>
        <div class="mini-stat-value text-info"><%= @guests_this_month %></div>
      </div>
      <div class="mini-stat-icon mini-stat-icon-info"><i class="bi bi-calendar-plus"></i></div>
    </div>
  </div>
</div>

<%= form_with url: forum_guests_path(forum_slug: @current_forum.slug), method: :get, local: true, class: "card mb-3" do %>
  <div class="card-body d-flex flex-wrap gap-2">
    <%= text_field_tag :q, params[:q], class: "form-control", placeholder: "Search by name or email...", style: "max-width: 280px;" %>
    <%= submit_tag "Filter", class: "btn btn-outline-secondary" %>
    <%= link_to "Reset", forum_guests_path(forum_slug: @current_forum.slug), class: "btn btn-link" %>
  </div>
<% end %>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Chapter</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Nature of Business</th>
          <th>Invited By</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @guests.each do |guest| %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <span class="row-avatar"><%= guest.full_name.first.upcase %></span>
                <span class="fw-semibold"><%= guest.full_name %></span>
                <% if guest.profile_submitted_at.present? %>
                  <span class="badge bg-success-subtle text-success" title="Filled in their own profile on <%= guest.profile_submitted_at.strftime('%d %b %Y') %>">Profile filled</span>
                <% end %>
              </div>
            </td>
            <td><%= guest.chapter&.name %></td>
            <td><%= guest.email %></td>
            <td><%= guest.phone %></td>
            <td><%= guest.nature_of_business %></td>
            <td><%= guest.invited_by_display || "—" %></td>
            <td class="text-end">
              <%= link_to forum_chapter_guest_path(forum_slug: @current_forum.slug, chapter_id: guest.chapter_id, id: guest.id), class: "icon-btn icon-btn-view", title: "View" do %>
                <i class="bi bi-eye"></i>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @guests.empty? %>
          <tr><td colspan="7" class="text-center text-muted py-4">No guests yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%= paginate @guests %>
