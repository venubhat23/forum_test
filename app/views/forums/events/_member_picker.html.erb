<% members_by_chapter = members.includes(:chapter).order(:full_name).group_by(&:chapter) %>

<div data-controller="member-picker">
  <div class="d-flex flex-wrap gap-2 mb-2">
    <button type="button" class="btn btn-sm btn-outline-primary" data-action="member-picker#selectAll">Select All Forum Members</button>
    <select data-member-picker-target="chapterFilter" class="form-select form-select-sm" style="max-width: 220px;">
      <option value="">Select a chapter...</option>
      <% @current_forum.chapters.order(:name).each do |chapter| %>
        <option value="<%= chapter.id %>"><%= chapter.name %></option>
      <% end %>
    </select>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="member-picker#selectChapter">Select All in Chapter</button>
    <button type="button" class="btn btn-sm btn-outline-danger" data-action="member-picker#clearAll">Clear</button>
  </div>

  <div class="border rounded p-3" style="max-height: 320px; overflow-y: auto;">
    <% members_by_chapter.each do |chapter, chapter_members| %>
      <div class="fw-semibold small text-uppercase text-muted mb-2 mt-2">
        <%= chapter&.name || "No Chapter" %>
      </div>
      <% chapter_members.each do |member| %>
        <% is_annual_member = member.respond_to?(:annual_fee_paid?) && member.annual_fee_paid? %>
        <div class="form-check mb-1">
          <%= check_box_tag field_name, member.id, false, class: "form-check-input",
                id: "member-picker-#{member.id}", data: { chapter_id: chapter&.id, member_picker_target: "checkbox" } %>
          <%= label_tag "member-picker-#{member.id}", class: "form-check-label #{"text-success fw-semibold" if is_annual_member}" do %>
            <%= member.display_name %><%= " — Annual Member (fee waived)" if is_annual_member %>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <% if members_by_chapter.empty? %>
      <div class="text-muted small py-2">No members available.</div>
    <% end %>
  </div>
  <div class="form-text">
    Check members individually, or use the buttons above for bulk selection.
    <span class="text-success fw-semibold">Annual Members</span> have already paid their dues — they won't be asked to pay this event's fee.
  </div>
</div>
